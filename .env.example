# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Providers (Mock provider enabled by default for seamless offline local running)
LLM_PROVIDER=mock
# Options: mock, openai, gemini, ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Orchestrator Guardrails & Budget Defaults
MAX_RETRIES_PER_TICKET=3
MAX_TOOL_CALLS_PER_TICKET=15
MAX_EXECUTION_TIME_SECONDS=300
HUMAN_APPROVAL_TIMEOUT_SECONDS=180

# Risk Policy Engine Thresholds
AUTO_APPROVE_LOW_RISK=true
HIGH_RISK_KEYWORDS=auth,password,payment,secret,database_drop,privilege

# Paths
LOCAL_REPOS_DIR=./demo_repos
AUDIT_LOG_DIR=./data/audit_logs
MEMORY_STORE_DIR=./data/institutional_memory
